body {
  font-family: 'Source Sans 3', sans-serif;
  margin: 0;
  color: #666;
  line-height: 1.7;
}

.container {
  max-width: 900px;
  margin: auto;
  padding: 4em 2em;
}

/* SIDEBAR */
#header {
  background: #4acaa8;
  color: white;
  width: 22em;
  height: 100vh;
  position: fixed;
  padding: 4em 2em;
  text-align: right;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

#header a {
  color: white;
  text-decoration: none;
}

#nav ul {
  padding: 0;
  list-style: none;
}

#nav li {
  margin: 1em 0;
}

#nav a {
  color: rgba(255,255,255,0.6);
}

#nav a:hover {
  color: white;
}

/* MAIN CONTENT */
#wrapper {
  margin-left: 22em;
  display: flex;
  align-items: center;
  min-height: 100vh;
}

#main {
  width: 100%;
}

/* TYPOGRAPHY */
h2 {
  color: #4acaa8;
  font-size: 2.5em;
}

h3 {
  margin-bottom: 1em;
}

/* GRID */
.text-grid {
  display: grid;
  gap: 1.5em;
  margin-top: 2em;
}

.text-grid.three-up {
  grid-template-columns: repeat(3, 1fr);
}

.text-grid.two-up {
  grid-template-columns: repeat(2, 1fr);
}

.text-card {
  border: 1px solid #ddd;
  padding: 1.5em;
  border-radius: 6px;
  background: #fafafa;
}

/* MOBILE */
@media (max-width: 900px) {

  #header {
    position: relative;
    width: 100%;
    height: auto;
    text-align: left;
  }

  #wrapper {
    margin-left: 0;
    display: block;
  }

  .text-grid.three-up,
  .text-grid.two-up {
    grid-template-columns: 1fr;
  }
}
